{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProtectedCorpusManifest",
  "type": "object",
  "required": [
    "builder_configuration_digest",
    "calibration_snapshot_digest",
    "corpus_digest",
    "datasheet_revision",
    "exclusions",
    "foundry_revision",
    "inputs",
    "limitation_codes",
    "members",
    "model_qualification_ready",
    "ontology_snapshot_digest",
    "schema_version",
    "splits"
  ],
  "properties": {
    "builder_configuration_digest": {
      "type": "string"
    },
    "calibration_snapshot_digest": {
      "type": "string"
    },
    "corpus_digest": {
      "type": "string"
    },
    "datasheet_revision": {
      "type": "string"
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CorpusExclusion"
      }
    },
    "foundry_revision": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CorpusInputBinding"
      }
    },
    "limitation_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CorpusMember"
      }
    },
    "model_qualification_ready": {
      "type": "boolean"
    },
    "ontology_snapshot_digest": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "splits": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ProtectedSplitManifest"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "CorpusExclusion": {
      "type": "object",
      "required": [
        "example_id",
        "reason_codes",
        "rights_snapshot_ids"
      ],
      "properties": {
        "example_id": {
          "type": "string"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rights_snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "CorpusInputBinding": {
      "type": "object",
      "required": [
        "content_sha256",
        "role",
        "row_count"
      ],
      "properties": {
        "content_sha256": {
          "type": "string"
        },
        "logical_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": "string"
        },
        "row_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "CorpusMember": {
      "type": "object",
      "required": [
        "assigned_split",
        "document_family_id",
        "example_content_sha256",
        "example_id",
        "lineage_group_ids",
        "near_duplicate_group_id",
        "restriction_codes",
        "rights_snapshot_ids",
        "training_permitted"
      ],
      "properties": {
        "assigned_split": {
          "$ref": "#/definitions/ProtectedSplit"
        },
        "document_family_id": {
          "type": "string"
        },
        "example_content_sha256": {
          "type": "string"
        },
        "example_id": {
          "type": "string"
        },
        "lineage_group_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manufacturer_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "near_duplicate_group_id": {
          "type": "string"
        },
        "restriction_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revision_group_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "rights_snapshot_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "synthetic_root_example_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "template_family_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "training_permitted": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ProtectedSplit": {
      "type": "string",
      "enum": [
        "train",
        "development",
        "template-held-out",
        "document-family-held-out",
        "manufacturer-held-out",
        "final-blind-test"
      ]
    },
    "ProtectedSplitManifest": {
      "type": "object",
      "required": [
        "artifact_digest",
        "hidden",
        "limitation_codes",
        "member_ids",
        "split"
      ],
      "properties": {
        "artifact_digest": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        },
        "limitation_codes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "member_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "split": {
          "$ref": "#/definitions/ProtectedSplit"
        }
      },
      "additionalProperties": false
    }
  }
}
