{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ModelQualificationExhaustion",
  "type": "object",
  "required": [
    "audited_at_utc",
    "blocker_codes",
    "datasheet_base_revision",
    "eligible_new_disjoint_document_groups",
    "eligible_new_hidden_final_artifacts",
    "eligible_new_manufacturer_groups",
    "fdx5_training_started",
    "foundry_source_audit_revision",
    "foundry_source_audit_sha256",
    "minimum_pairwise_disjoint_document_family_groups",
    "minimum_pairwise_disjoint_manufacturer_groups",
    "minimum_pairwise_disjoint_publisher_lineage_groups",
    "minimum_pairwise_disjoint_template_groups",
    "model_qualification_ready",
    "protected_corpus_digest",
    "protected_corpus_member_count",
    "qualification_digest",
    "qualification_eligible_member_count",
    "required_nonempty_splits",
    "schema_version"
  ],
  "properties": {
    "audited_at_utc": {
      "type": "string"
    },
    "blocker_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "datasheet_base_revision": {
      "type": "string"
    },
    "eligible_new_disjoint_document_groups": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "eligible_new_hidden_final_artifacts": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "eligible_new_manufacturer_groups": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "fdx5_training_started": {
      "type": "boolean"
    },
    "foundry_source_audit_revision": {
      "type": "string"
    },
    "foundry_source_audit_sha256": {
      "type": "string"
    },
    "minimum_pairwise_disjoint_document_family_groups": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "minimum_pairwise_disjoint_manufacturer_groups": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "minimum_pairwise_disjoint_publisher_lineage_groups": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "minimum_pairwise_disjoint_template_groups": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "model_qualification_ready": {
      "type": "boolean"
    },
    "protected_corpus_digest": {
      "type": "string"
    },
    "protected_corpus_member_count": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "qualification_digest": {
      "type": "string"
    },
    "qualification_eligible_member_count": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "required_nonempty_splits": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ProtectedSplit"
      }
    },
    "schema_version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ProtectedSplit": {
      "type": "string",
      "enum": [
        "train",
        "development",
        "template-held-out",
        "document-family-held-out",
        "manufacturer-held-out",
        "final-blind-test"
      ]
    }
  }
}
